{
  "name": "apipj",
  "version": "0.2.0",
  "description": "API CNPJ gratuita para Node.js e TypeScript: consultar CNPJ na Receita Federal (razão social, situação, endereço, CNAE, sócios), validar CNPJ e CNPJ alfanumérico. Plano grátis com 50 mil consultas/mês.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "api-cnpj",
    "cnpj",
    "consulta-cnpj",
    "consultar-cnpj",
    "api-cnpj-gratuita",
    "api-cnpj-gratis",
    "cnpj-gratis",
    "cnpj-api",
    "api-consulta-cnpj",
    "api-receita-federal",
    "receita-federal",
    "dados-cnpj",
    "buscar-cnpj",
    "validar-cnpj",
    "validador-cnpj",
    "validacao-cnpj",
    "cnpj-validator",
    "cnpj-alfanumerico",
    "razao-social",
    "situacao-cadastral",
    "cnae",
    "simples-nacional",
    "mei",
    "dados-abertos",
    "pessoa-juridica",
    "empresas",
    "brasil",
    "brazil",
    "typescript",
    "sdk",
    "api"
  ],
  "homepage": "https://apipj.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apipj/apipj-js.git"
  },
  "bugs": {
    "url": "https://github.com/apipj/apipj-js/issues"
  },
  "author": "MASTER BI TECNOLOGIA LTDA (https://apipj.com.br)",
  "license": "MIT"
}
